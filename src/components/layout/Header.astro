---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';
const isAbout = pathname === '/about' || pathname === '/about/';
---
<header class="fixed top-0 left-0 right-0 z-50 h-8 bg-white border-b-2 border-black">
  <nav class="max-w-4xl mx-auto px-4 h-full flex items-center justify-between">
    <a href="/" class="font-display font-bold text-xl text-black hover:text-gray-700 transition-colors">Jake Reddy</a>
    <div class="flex gap-4">
      <a
        href="/"
        aria-current={isHome ? 'page' : undefined}
        class="nav-link font-body text-sm font-medium text-black hover:text-gray-600 transition-colors"
      >Home</a>
      <a
        href="/about"
        aria-current={isAbout ? 'page' : undefined}
        class="nav-link font-body text-sm font-medium text-black hover:text-gray-600 transition-colors"
      >About</a>
    </div>
  </nav>
</header>

<style>
  .nav-link[aria-current="page"] {
    font-weight: 700;
    border-bottom: 2px solid currentColor;
  }
</style>
