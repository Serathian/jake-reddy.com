---
const { pathname } = Astro.url;
const isBlog = pathname.startsWith('/blog');
const isProjects = pathname.startsWith('/projects');
---

<header
  class="fixed top-0 left-0 right-0 z-[1000] bg-white/95 dark:bg-black/95 backdrop-blur-sm border-b border-[#E5E5E5] dark:border-[#262626] transition-colors duration-200"
>
  <nav class="max-w-[1200px] mx-auto px-4 py-3 md:px-8 flex items-center justify-between">
    <a
      href="/"
      class="font-display text-base font-bold text-black dark:text-white hover:opacity-70 transition-opacity"
    >
      JAKE REDDY
    </a>

    <div class="flex items-center gap-6">
      <div class="flex items-center gap-4 md:gap-6">
        <a
          href="/blog"
          aria-current={isBlog ? 'page' : undefined}
          class="nav-link font-display text-xs md:text-sm font-semibold text-[#595959] dark:text-[#A3A3A3] hover:text-black dark:hover:text-white uppercase tracking-[1px] transition-colors flex items-center gap-1.5"
        >
          <span
            class={`w-1.5 h-1.5 transition-colors ${isBlog ? 'bg-[#7c3aed] dark:bg-[#a78bfa]' : 'bg-[#D4D4D4] dark:bg-[#404040]'}`}
            aria-hidden="true"></span>
          Blog
        </a>
        <a
          href="/projects"
          aria-current={isProjects ? 'page' : undefined}
          class="nav-link font-display text-xs md:text-sm font-semibold text-[#595959] dark:text-[#A3A3A3] hover:text-black dark:hover:text-white uppercase tracking-[1px] transition-colors flex items-center gap-1.5"
        >
          <span
            class={`w-1.5 h-1.5 transition-colors ${isProjects ? 'bg-[#7c3aed] dark:bg-[#a78bfa]' : 'bg-[#D4D4D4] dark:bg-[#404040]'}`}
            aria-hidden="true"></span>
          Projects
        </a>
      </div>

      <!-- Stylish Modern Theme Toggle Switch -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle Dark Mode"
        class="group flex items-center gap-2 cursor-pointer focus:outline-none"
      >
        <span
          class="font-display text-[10px] font-bold tracking-wider text-[#737373] dark:text-[#A3A3A3] group-hover:text-black dark:group-hover:text-white transition-colors"
        >
          <span class="dark:hidden">LIGHT</span>
          <span class="hidden dark:inline">DARK</span>
        </span>
        <div
          class="w-11 h-6 border border-[#E5E5E5] dark:border-[#333333] bg-[#F5F5F5] dark:bg-[#181818] p-0.5 relative transition-colors"
        >
          <div
            class="w-4.5 h-4.5 bg-black dark:bg-white flex items-center justify-center transition-transform duration-200 dark:translate-x-5"
          >
            <!-- Sun Icon (Light Mode) -->
            <svg
              class="w-3 h-3 text-white dark:hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
            <!-- Moon Icon (Dark Mode) -->
            <svg
              class="w-3 h-3 text-black hidden dark:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path>
            </svg>
          </div>
        </div>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-link[aria-current='page'] {
    color: #000000;
  }
  :global(.dark) .nav-link[aria-current='page'] {
    color: #ffffff;
  }
</style>

<script>
  function initThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
