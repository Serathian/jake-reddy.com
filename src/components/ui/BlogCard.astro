---
import type { BlogPost } from '../../types';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const tagsList = post.tags ? post.tags.join(',') : '';
const searchableText = `${post.title} ${post.excerpt} ${tagsList}`.toLowerCase();
---

<a
  href={`/blog/${post.slug}`}
  class="blog-card group border border-[#E5E5E5] dark:border-[#333333] p-6 bg-white dark:bg-[#181818] block hover:border-black dark:hover:border-white transition-colors cursor-pointer"
  data-searchable={searchableText}
  data-tags={tagsList}
>
  <div
    class="flex items-center justify-between gap-4 mb-3 text-xs font-display text-[#525252] dark:text-[#A3A3A3]"
  >
    <time datetime={post.publishedAt}>
      {
        new Date(post.publishedAt).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        })
      }
    </time>
    {post.readingTime && <span>{post.readingTime}</span>}
  </div>

  <h3
    class="font-display text-xl font-bold tracking-tight text-black dark:text-white group-hover:underline transition-colors mb-3"
  >
    {post.title}
  </h3>

  <p class="font-body text-sm text-[#525252] dark:text-[#A3A3A3] leading-relaxed mb-6">
    {post.excerpt}
  </p>

  {
    post.tags && post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {post.tags.map((tag) => (
          <span class="font-display text-xs px-2 py-0.5 border border-[#E5E5E5] dark:border-[#333333] text-[#525252] dark:text-[#A3A3A3]">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</a>
