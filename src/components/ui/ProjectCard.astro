---
import type { Project } from '../../types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const tagsList = project.tags ? project.tags.join(',') : '';
const searchableText = `${project.title} ${project.description} ${tagsList}`.toLowerCase();
---

<div
  class="project-card border border-[#E5E5E5] dark:border-[#333333] p-6 bg-white dark:bg-[#181818] flex flex-col justify-between hover:border-black dark:hover:border-white transition-colors"
  data-searchable={searchableText}
  data-tags={tagsList}
>
  <div>
    <h3 class="font-display text-xl font-bold tracking-tight text-black dark:text-white mb-3">
      {project.title}
    </h3>

    <p class="font-body text-sm text-[#525252] dark:text-[#A3A3A3] leading-relaxed mb-6">
      {project.description}
    </p>
  </div>

  <div>
    {
      project.tags && project.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {project.tags.map((tag) => (
            <span class="font-display text-xs px-2 py-0.5 border border-[#E5E5E5] dark:border-[#333333] text-[#525252] dark:text-[#A3A3A3]">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {
      project.links && project.links.length > 0 && (
        <div class="flex items-center gap-4 pt-4 border-t border-[#E5E5E5] dark:border-[#333333]">
          {project.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-display text-xs font-bold uppercase tracking-wider text-black dark:text-white hover:underline cursor-pointer flex items-center gap-1"
            >
              {link.label}
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>
