---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, getBlogPostBySlug } from '../../lib/cms';
import { renderMarkdownToHtml } from '../../utils/markdown';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/404');
}

const htmlContent = renderMarkdownToHtml(post.content);
---

<BaseLayout
  title={post.seoTitle ? `${post.seoTitle} | Jake Reddy` : `${post.title} | Jake Reddy`}
  description={post.seoDescription || post.excerpt}
  ogType="article"
  publishedTime={post.publishedAt}
>
  <article class="max-w-[800px] mx-auto px-4 py-12 md:px-8">
    <div class="mb-8 pb-8 border-b border-[#E5E5E5] dark:border-[#333333]">
      <a
        href="/blog"
        class="font-display text-xs font-bold uppercase tracking-wider text-[#525252] dark:text-[#A3A3A3] hover:text-black dark:hover:text-white transition-colors mb-6 inline-block"
      >
        ← Back to Blog
      </a>

      <div
        class="flex items-center gap-4 text-xs font-display text-[#525252] dark:text-[#A3A3A3] mb-4"
      >
        <time datetime={post.publishedAt}>
          {
            new Date(post.publishedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        {post.readingTime && <span>• {post.readingTime}</span>}
      </div>

      <h1
        class="font-display text-3xl sm:text-4xl md:text-5xl font-bold uppercase tracking-tight leading-tight mb-6"
      >
        {post.title}
      </h1>

      <p class="font-body text-lg md:text-xl text-[#525252] dark:text-[#A3A3A3] leading-relaxed">
        {post.excerpt}
      </p>

      {
        post.tags && post.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {post.tags.map((tag) => (
              <span class="font-display text-xs px-2.5 py-1 border border-[#E5E5E5] dark:border-[#333333] text-[#525252] dark:text-[#A3A3A3]">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <!-- Main Post Content -->
    <div class="prose dark:prose-invert max-w-none" set:html={htmlContent} />

    <div
      class="mt-16 pt-8 border-t border-[#E5E5E5] dark:border-[#333333] flex justify-between items-center"
    >
      <a
        href="/blog"
        class="font-display text-xs font-bold uppercase tracking-wider hover:underline"
      >
        ← Back to All Articles
      </a>
      <a href="/" class="font-display text-xs font-bold uppercase tracking-wider hover:underline">
        Jake Reddy Home →
      </a>
    </div>
  </article>
</BaseLayout>
