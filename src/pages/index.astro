---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import BlogCard from '../components/ui/BlogCard.astro';
import { getProjects, getBlogPosts } from '../lib/cms';

const allProjects = await getProjects();
const allPosts = await getBlogPosts();

const featuredProjects = allProjects.filter((p) => p.featured);
const latestPosts = allPosts.slice(0, 2);
---

<BaseLayout
  title="Jake Reddy | Full-Stack Developer"
  description="Personal site, blog, and project showcase by Jake Reddy. Five years building full-stack products with craft and clarity."
>
  <!-- Hero Section with subtle signature purple accent line at top -->
  <section
    class="max-w-[1200px] mx-auto px-4 py-12 md:px-8 md:py-20 border-b border-[#E5E5E5] dark:border-[#333333] relative"
  >
    <div class="absolute top-0 left-4 md:left-8 w-12 h-1 bg-[#7c3aed] dark:bg-[#a78bfa]"></div>

    <p
      class="font-display text-xs md:text-sm text-[#525252] dark:text-[#A3A3A3] uppercase tracking-[2px] mb-4"
    >
      FULL-STACK SOFTWARE ENGINEER
    </p>
    <h1
      class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tighter uppercase leading-none mb-6"
    >
      JAKE REDDY
    </h1>
    <p
      class="font-body text-base md:text-xl text-[#525252] dark:text-[#A3A3A3] max-w-2xl leading-relaxed"
    >
      Building robust software solutions across the entire stack. Language-agnostic,
      fundamentals-driven engineering with a focus on architecture, performance, and craft.
    </p>
  </section>

  <!-- Featured Projects Section -->
  <section
    class="max-w-[1200px] mx-auto px-4 py-12 md:px-8 border-b border-[#E5E5E5] dark:border-[#333333]"
  >
    <div class="flex items-center justify-between mb-8">
      <h2
        class="font-display text-2xl md:text-3xl font-bold uppercase tracking-tight flex items-center gap-3"
      >
        <span
          class="w-2.5 h-2.5 bg-[#7c3aed] dark:bg-[#a78bfa] inline-block shrink-0"
          aria-hidden="true"></span>
        Featured Work
      </h2>
      <a
        href="/projects"
        class="font-display text-xs font-bold uppercase tracking-wider text-black dark:text-white hover:underline"
      >
        All Projects ({allProjects.length}) →
      </a>
    </div>

    {
      featuredProjects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <div class="border border-dashed border-[#E5E5E5] dark:border-[#262626] rounded-lg p-8 text-center">
          <p class="font-mono text-xs uppercase tracking-widest text-[#737373] dark:text-[#A3A3A3]">
            No projects published yet
          </p>
        </div>
      )
    }
  </section>

  <!-- Latest Writing Section -->
  <section class="max-w-[1200px] mx-auto px-4 py-12 md:px-8">
    <div class="flex items-center justify-between mb-8">
      <h2
        class="font-display text-2xl md:text-3xl font-bold uppercase tracking-tight flex items-center gap-3"
      >
        <span
          class="w-2.5 h-2.5 bg-[#7c3aed] dark:bg-[#a78bfa] inline-block shrink-0"
          aria-hidden="true"></span>
        Latest Writing
      </h2>
      <a
        href="/blog"
        class="font-display text-xs font-bold uppercase tracking-wider text-black dark:text-white hover:underline"
      >
        All Articles ({allPosts.length}) →
      </a>
    </div>

    {
      latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {latestPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <div class="border border-dashed border-[#E5E5E5] dark:border-[#262626] rounded-lg p-8 text-center">
          <p class="font-mono text-xs uppercase tracking-widest text-[#737373] dark:text-[#A3A3A3]">
            No articles published yet
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
